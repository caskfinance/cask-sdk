{
	"name": "@caskfinance/sdk",
	"version": "0.0.1",
	"description": "Cask SDK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/caskfinance/cask-sdk.git",
		"directory": "crates/cask-sdk-node"
	},
	"main": "index.js",
	"types": "index.d.ts",
	"files": [
		"index.js",
		"index.d.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"napi": {
		"binaryName": "cask-sdk",
		"targets": [
			"x86_64-apple-darwin",
			"aarch64-apple-darwin",
			"x86_64-unknown-linux-gnu",
			"aarch64-unknown-linux-gnu",
			"x86_64-pc-windows-msvc"
		]
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "napi build --platform --release",
		"build:debug": "napi build --platform",
		"test": "node --test test/*.test.js"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.0.0"
	}
}
